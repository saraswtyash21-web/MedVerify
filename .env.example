# MedVerify Environment Configuration
# 
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# For local development, Vite automatically loads .env files.
# For production deployment, set these as environment variables in your hosting platform.

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these values from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

# Supabase project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=your-supabase-project-url

# Supabase anon/public key (found in Project Settings > API)
# This is safe to expose in client-side code - it's designed for this purpose
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ============================================================================
# AUTHENTICATION MODE
# ============================================================================
# Options: 'demo' | 'supabase'
# - 'demo': Uses localStorage (NOT secure, for development only)
# - 'supabase': Uses Supabase Auth (secure, requires VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY)

VITE_AUTH_MODE=demo

# ============================================================================
# APPLICATION MODE
# ============================================================================
# Options: 'demo' | 'production'
# - 'demo': Demo features enabled (sample scans, synthetic data)
# - 'production': Only real configured sources used

VITE_APP_MODE=demo

# ============================================================================
# PRODUCT CATALOG
# ============================================================================
# Enable Supabase-backed product catalog for barcode lookup
# Requires running supabase/migrations/002_product_catalog.sql first
# Options: 'true' | 'false'
# - 'true': Use Supabase product_catalog table for barcode lookup
# - 'false': No catalog configured, barcode numbers shown but not looked up

VITE_USE_SUPABASE_CATALOG=false

# ============================================================================
# NOTES
# ============================================================================
# - Supabase free tier includes 500MB database, 50,000 monthly active users
# - Run the SQL migration in supabase/migrations/001_initial.sql to create tables
# - Enable Row Level Security (RLS) policies as documented in the migration file
# - For production, also configure data sources in src/config.ts
